# Copy this file to backend/.env and fill in your own values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=idp_db

# Allowed browser origins for the React frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Phase 4: sign-in security ----
# Generate your own secret (any long random text) and paste it here. Never share it, never commit it:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste_a_long_random_secret_here
JWT_EXPIRE_SECONDS=1800
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Phase 4: e-mail through Brevo (optional). "console" = nothing is sent, the log only shows the recipient.
# To send real e-mail: set EMAIL_BACKEND=smtp and fill the three values below in YOUR backend/.env only.
EMAIL_BACKEND=console
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=DocuMind AI
