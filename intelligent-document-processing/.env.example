# FOR DOCKER ONLY. Copy this file to ".env" in this same folder (next to docker-compose.yml).
# These values create a NEW MySQL database inside the Docker container.
# Do not use "$" in passwords (Docker Compose treats it specially).
DB_USER=idp_user
DB_PASSWORD=choose_a_password
DB_NAME=idp_db
MYSQL_ROOT_PASSWORD=choose_another_password
